# LLM Provider Configuration
API_KEY=
BASE_URL=
LLM_MODEL=
EMBEDDINGS_MODEL=openai/text-embedding-3-small

# Optional: Override models for specific agents
LABELER_A_MODEL=google/gemini-2.5-flash-lite
LABELER_B_MODEL=openai/gpt-4o
ADJUDICATOR_MODEL=anthropic/claude-sonnet-4.5

# LLM Caching (improves performance and reduces costs)
# Standard caching: Caches LLM responses based on full prompt
ENABLE_LLM_CACHE=true
LLM_CACHE_DIR=.llm_cache

# Output caching: Provider-specific caching (e.g., OpenAI's prompt caching)
# Only enable if your provider supports it
ENABLE_OUTPUT_CACHE=false
